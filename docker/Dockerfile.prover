# Prover sidecar image: Go HTTP service (go/proverservice) proving via the
# Rust Bulletproofs engine (rust/zkrp), invoked as a subprocess. Same
# hardening as the gateway image.

FROM rust:1-slim-bookworm AS rust-builder
WORKDIR /src
COPY rust/zkrp/ ./rust/zkrp/
WORKDIR /src/rust/zkrp
RUN cargo build --release

FROM golang:1.23-bookworm AS go-builder
WORKDIR /src/go
COPY go/ ./
ENV CGO_ENABLED=0
RUN go build -o /out/prover-service ./proverservice

FROM debian:bookworm-slim
RUN useradd --create-home --uid 1000 app
COPY --from=rust-builder /src/rust/zkrp/target/release/zkrp /usr/local/bin/zkrp
COPY --from=go-builder /out/prover-service /usr/local/bin/prover-service

USER app
ENV ZKGW_PORT=8753 \
    ZKGW_SOURCE_VALUE=735000000 \
    ZKGW_AGENT_ID=exec-agent-07 \
    ZKGW_ZKRP_BIN=/usr/local/bin/zkrp

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD sh -c '/usr/local/bin/prover-service --healthcheck --port "$ZKGW_PORT"'

ENTRYPOINT ["sh", "-c", "exec /usr/local/bin/prover-service --host 0.0.0.0 --port \"$ZKGW_PORT\" --zkrp-bin \"$ZKGW_ZKRP_BIN\""]
